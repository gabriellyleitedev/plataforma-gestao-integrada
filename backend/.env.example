NODE_ENV=development
DB_DRIVER=sqlite
# SQLite persiste localmente em backend/data. Produção exige DB_DRIVER=mysql.
SQLITE_PATH=data/platform.sqlite
PORT=3001
FRONTEND_URL=http://localhost:5173
# Preencha com credenciais locais próprias. Não versionar o arquivo .env.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=plataforma_gestao_integrada
DB_USER=
DB_PASSWORD=
DB_SSL=false
# Se TLS estiver habilitado, informe o caminho do certificado CA do provedor.
DB_SSL_CA_PATH=
