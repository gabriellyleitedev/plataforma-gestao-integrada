NODE_ENV=development
DB_DRIVER=sqlite
# SQLite persiste localmente em backend/data. Produção exige DB_DRIVER=mysql.
SQLITE_PATH=data/platform.sqlite
PORT=3001
FRONTEND_URL=http://localhost:5173
# Preencha com credenciais locais próprias. Não versionar o arquivo .env.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=plataforma_gestao_integrada
DB_USER=
DB_PASSWORD=
# Também podemos usar a URI MySQL completa no lugar dos campos DB_* de conexão.
DATABASE_URL=
DB_SSL=false
# Para TLS, usamos o certificado CA em texto ou o caminho de um arquivo.
DB_SSL_CA=
DB_SSL_CA_PATH=
