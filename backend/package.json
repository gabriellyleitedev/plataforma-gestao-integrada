{
  "name": "@pgi/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "test": "node --test \"test/*.test.js\"",
    "test:mysql": "node --env-file-if-exists=.env scripts/test-mysql.js",
    "db:check": "node --env-file-if-exists=.env scripts/check-db.js"
  },
  "dependencies": {
    "cors": "2.8.6",
    "express": "5.3.0",
    "helmet": "8.3.0",
    "mysql2": "3.24.6"
  }
}
