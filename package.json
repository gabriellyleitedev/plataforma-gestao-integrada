{
  "name": "plataforma-gestao-integrada",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c blue,green \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "dev:frontend": "npm run dev -w frontend",
    "dev:backend": "npm run dev -w backend",
    "build": "npm run build -w frontend",
    "start": "npm run start -w backend",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test -w backend",
    "test:e2e": "playwright test",
    "test:mysql": "npm run test:mysql -w backend",
    "test:mysql:local": "node backend/scripts/mysql-portable-check.js",
    "db:check": "npm run db:check -w backend",
    "mysql:env": "node backend/scripts/create-mysql-env.js",
    "check": "npm run format:check && npm run lint && npm test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "concurrently": "10.0.6",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.14.0",
    "prettier": "3.6.2"
  }
}
